generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum PlatformRole {
  platform_owner
  platform_operator
}

enum ModuleCatalogKind {
  module
  page
  feature
}

enum ModuleCatalogStatus {
  draft
  active
  toBeDeprecated
  deprecated
}

enum PlanStatus {
  draft
  active
  archived
}

enum PlanBillingInterval {
  monthly
  yearly
  quarterly
  one_time
}

// -----------------------------------------------------------------------------
// COMPOSITE TYPES (MongoDB Embedded Documents)
// -----------------------------------------------------------------------------

type PlanPrice {
  currency String              @default("USD")
  amount   Float
  interval PlanBillingInterval @default(monthly)
  isActive Boolean             @default(true)
}

type PlanCredits {
  monthly  Int     @default(0)
  rollover Boolean @default(false)
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

// Dedicated platform users collection, isolated from tenant customers/users
model PlatformUser {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  email           String       @unique
  name            String
  passwordHash    String?
  googleId        String?      @unique
  role            PlatformRole @default(platform_operator)
  allowedFeatures String[]     @default([])
  isActive        Boolean      @default(true)
  tokenVersion    Int          @default(1)
  lastLoginAt     DateTime?
  refreshSessions RefreshSession[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([role, isActive])
  @@map("platform_users")
}

// Platform-owned catalog. These collections are shared with the tenant API,
// but are managed exclusively from the internal backoffice.
model PlatformTenant {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  slug               String   @unique
  name               String
  vertical           String
  status             String   @default("active")
  planKey            String?
  isActive           Boolean  @default(true)
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, isActive])
  @@map("tenants")
}

model TenantSubscription {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String    @db.ObjectId
  planKey            String
  status             String    @default("active")
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, status])
  @@map("subscriptions")
}

model TenantEntitlement {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String    @db.ObjectId
  capabilityKey      String
  effect             String    // allow | deny
  source             String    @default("owner_override") // plan | tenant_setting | owner_override | migration
  creditCost         Int       @default(0)
  creditAllocationId String?
  expiresAt          DateTime?
  reason             String?
  changedBy          String?   @db.ObjectId
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([tenantId, capabilityKey])
  @@index([tenantId])
  @@map("tenant_entitlements")
}

model PlatformPlan {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  key              String       @unique
  name             String
  description      String?
  status           PlanStatus   @default(draft)
  displayOrder     Int          @default(0)
  includedFeatures String[]     @default([])
  prices           PlanPrice[]
  credits          PlanCredits?
  limits           Json?
  trialDays        Int          @default(0)
  gracePeriodDays  Int          @default(3)
  isPopular        Boolean      @default(false)
  version          Int          @default(1)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, displayOrder])
  @@map("plans")
}

model TenantAddon {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String    @db.ObjectId
  addonKey   String
  credits    Int
  status     String    @default("active")
  renews     Boolean   @default(true)
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@map("tenant_addons")
}

model PlatformFeature {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  label       String
  description String?
  scope       String   @default("platform")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_features")
}

model RefreshSession {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  tokenHash  String   @unique
  tokenVersion Int
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?  @db.ObjectId
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// Global, platform-scoped definition of modules, pages and features.
// No tenantId — tenant activation is stored separately (future issue).
model ModuleCatalogEntry {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  key                  String              @unique        // e.g. "services.bookings.photo_upload"
  kind                 ModuleCatalogKind
  moduleKey            String
  sectionKey           String
  pageKey              String?
  scope                String              @default("platform") // platform | tenant | public
  name                 String
  description          String?
  status               ModuleCatalogStatus @default(draft)
  isArchived           Boolean             @default(false)

  // Maintenance — orthogonal to status; a module can be active + under maintenance
  maintenanceEnabled   Boolean             @default(false)
  maintenanceMessage   String?
  maintenanceStartsAt  DateTime?
  maintenanceEndsAt    DateTime?
  maintenanceChangedBy String?             @db.ObjectId

  version              Int                 @default(1)
  dependencies         String[]            @default([])
  requiredPermissions  String[]            @default([])
  availability         Json?               // { plans: string[], requiresSubscription: boolean }
  compatibility        Json?               // { minVersion: string, maxVersion?: string }
  metadata             Json?

  // Source metadata
  ownerTeam            String?
  manifest             String?
  autoDiscovered       Boolean             @default(false)
  catalogVersion       String?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([kind])
  @@index([status, isArchived])
  @@index([sectionKey, pageKey])
  @@index([moduleKey])
  @@map("module_catalog")
}
