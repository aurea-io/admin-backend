generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum PlatformRole {
  platform_owner
  platform_operator
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

// Dedicated platform users collection, isolated from tenant customers/users
model PlatformUser {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  email           String       @unique
  name            String
  passwordHash    String?
  googleId        String?      @unique
  role            PlatformRole @default(platform_operator)
  allowedFeatures String[]     @default([])
  isActive        Boolean      @default(true)
  tokenVersion    Int          @default(1)
  lastLoginAt     DateTime?
  refreshSessions RefreshSession[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([role, isActive])
  @@map("platform_users")
}

// Platform-owned catalog. These collections are shared with the tenant API,
// but are managed exclusively from the internal backoffice.
model PlatformTenant {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  slug              String   @unique
  name              String
  vertical          String
  isActive          Boolean  @default(true)
  maintenanceMode   Boolean  @default(false)
  maintenanceMessage String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("tenants")
}

model PlatformPlan {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String   @unique
  name            String
  description     String?
  includedFeatures String[] @default([])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("plans")
}

model PlatformFeature {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  label       String
  description String?
  scope       String   @default("platform")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_features")
}

model RefreshSession {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  tokenHash  String   @unique
  tokenVersion Int
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?  @db.ObjectId
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
