generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum PlatformRole {
  platform_owner
  platform_operator
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

// Dedicated platform users collection, isolated from tenant customers/users
model PlatformUser {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  email           String       @unique
  name            String
  passwordHash    String?
  googleId        String?      @unique
  role            PlatformRole @default(platform_operator)
  allowedFeatures String[]     @default([])
  isActive        Boolean      @default(true)
  tokenVersion    Int          @default(1)
  lastLoginAt     DateTime?
  refreshSessions RefreshSession[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([role, isActive])
  @@map("platform_users")
}

model RefreshSession {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  tokenHash  String   @unique
  tokenVersion Int
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?  @db.ObjectId
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
