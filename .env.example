# Database (MongoDB connection string shared with Aurea cluster)
DATABASE_URL="mongodb://localhost:27017/aurea?authSource=admin"

# Server
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:5175

# JWT Security for Platform
JWT_ACCESS_SECRET="change-me-platform-jwt-secret"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Initial Platform Owner Provisioning (Required only when running npm run seed)
PLATFORM_OWNER_EMAIL="owner@example.com"
PLATFORM_OWNER_NAME="Platform Administrator"
PLATFORM_OWNER_PASSWORD="your-strong-password-here"
